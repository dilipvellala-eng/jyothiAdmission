NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/school_admissions
JWT_SECRET=replace-with-a-long-random-secret
PII_HASH_SECRET=replace-with-a-separate-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Admissions Office <no-reply@school.test>"
SMS_PROVIDER=log
