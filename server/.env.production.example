NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/school_admissions
JWT_SECRET=replace-with-a-long-random-production-secret
PII_HASH_SECRET=replace-with-a-separate-long-random-production-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-vercel-app.vercel.app
CLIENT_URLS=https://your-vercel-app.vercel.app,https://your-custom-domain.com
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Admissions Office <no-reply@school.test>"
SMS_PROVIDER=log
